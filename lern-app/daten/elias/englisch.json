 "wissen": [
  {
   "titel": "should / shouldn't",
   "kurz": "Ratschläge geben",
   "text": [
    "Mit should gibst du einen Rat: Du solltest … – mit shouldn't sagst du: Du solltest nicht …",
    "should bleibt IMMER gleich – auch bei he/she/it kein -s. Danach kommt die Grundform des Verbs, ohne „to“."
   ],
   "schritte": [
    "Wer? (I, you, he …)",
    "should oder shouldn't",
    "Verb in der Grundform (go, eat, see …)",
    "Rest des Satzes"
   ],
   "beispiel": "Haaland is tired.\n→ He should go to bed.\n→ He shouldn't watch TV so late.\n\n✗ He shoulds go   ✗ He should to go   ✓ He should go",
   "merke": "should + Grundform. Kein -s, kein to.",
   "video": "should shouldn't english grammar einfach erklärt"
  },
  {
   "titel": "a oder an?",
   "kurz": "Der unbestimmte Artikel",
   "text": [
    "Es kommt auf den KLANG am Wortanfang an, nicht auf den Buchstaben.",
    "an vor einem Vokal-Laut (a, e, i, o, u gesprochen), a vor einem Konsonanten-Laut."
   ],
   "schritte": [
    "Sprich das Wort laut aus.",
    "Klingt der Anfang wie a, e, i, o, u? → an",
    "Sonst → a"
   ],
   "beispiel": "an apple, an ostrich, an old house, an hour (h ist stumm!)\na ghost, a pumpkin, a dog, a uniform (klingt wie „ju“)",
   "merke": "Das Ohr entscheidet, nicht das Auge.",
   "video": "a or an english grammar erklärt"
  },
  {
   "titel": "Komparativ – vergleichen mit than",
   "kurz": "bigger than, more dangerous than",
   "text": [
    "Wenn du ZWEI Dinge vergleichst, nimmst du den Komparativ + than."
   ],
   "schritte": [
    "Kurzes Adjektiv → -er: fast → faster, tall → taller",
    "Endet auf -y → -ier: heavy → heavier, funny → funnier",
    "Ein Vokal + Konsonant am Ende → verdoppeln: big → bigger, hot → hotter",
    "Lange Adjektive → more: more dangerous, more intelligent",
    "Unregelmäßig: good → better, bad → worse"
   ],
   "beispiel": "Haaland is stronger than Saka.\nSalah is faster than Haaland.\nA snake is more dangerous than a spider.",
   "merke": "Komparativ + than (nicht then!).",
   "video": "comparative adjectives english erklärt deutsch"
  },
  {
   "titel": "as … as – gleich viel",
   "kurz": "as big as, not as fast as",
   "text": [
    "Wenn zwei Dinge GLEICH sind, nimmst du as + Grundform + as.",
    "Verneint (not as … as) heißt es: weniger … als."
   ],
   "schritte": [
    "as",
    "Adjektiv in der GRUNDFORM (big, strong, good)",
    "as"
   ],
   "beispiel": "Haaland is as strong as Salah.\nSaka isn't as tall as Haaland.\n\n✗ as stronger as   ✗ as better as   ✓ as strong as / as good as",
   "merke": "Zwischen as und as steht NIE ein Komparativ. Das ist der häufigste Fehler!",
   "video": "as as comparison english grammar"
  },
  {
   "titel": "Superlativ – der/die/das Beste",
   "kurz": "the fastest, the most dangerous",
   "text": [
    "Wenn etwas an der Spitze ist (von dreien oder mehr), nimmst du den Superlativ mit the."
   ],
   "schritte": [
    "Kurz → the …-est: the fastest, the tallest",
    "-y → the …-iest: the heaviest, the funniest",
    "Lang → the most …: the most dangerous, the most venomous",
    "Unregelmäßig: good → the best, bad → the worst"
   ],
   "beispiel": "The cheetah is the fastest animal on land.\nHaaland is the strongest.\nThe taipan is the most venomous snake.",
   "merke": "Komparativ = zwei vergleichen (+ than). Superlativ = der/die/das -ste (+ the).",
   "video": "superlative adjectives english erklärt"
  }
 ],
